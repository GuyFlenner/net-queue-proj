  <diagram name="3 - Deployment and Runtime Topology" id="deploy">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t3" value="Deployment / Runtime Topology &#8212; single-process, in-memory, no external infrastructure" style="text;strokeColor=none;fillColor=#eef2f7;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="Client" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="d2" value="Single ASP.NET Core Process&lt;br&gt;&lt;i&gt;(single container / single instance &#8212; not separate deployables)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;verticalAlign=top;align=center;spacingTop=10;fontColor=#000000;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="680" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="d3" value="Minimal API Host&lt;br&gt;(EmailProcessing.Api)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="210" width="560" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="d4" value="BackgroundTaskQueue (Singleton)&lt;br&gt;in-memory bounded Channel&amp;lt;T&amp;gt; (capacity 100)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="360" width="560" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="d5" value="QueuedTaskProcessingService&lt;br&gt;(Hosted Service / BackgroundService)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="510" width="560" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="note_single" value="&lt;b&gt;Single-process by design&lt;/b&gt;&lt;br&gt;No external dependencies: no database, no message broker (no RabbitMQ / Service Bus / Kafka), no distributed coordination &#8212; per the task's own constraints, not an oversight." style="shape=mxgraph.note;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="210" width="300" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="note_prod" value="&lt;b&gt;Production implication&lt;/b&gt;&lt;br&gt;In-memory queue backlog is LOST on process restart or crash &#8212; no persistence, no durability.&lt;br&gt;Accepted, explicitly out-of-scope limitation for this exercise &#8212; not an oversight." style="shape=mxgraph.note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="430" width="300" height="190" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="de1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#555555;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="d1" target="d3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="de2" value="enqueues work items&lt;br&gt;(in-process call)" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#555555;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="d3" target="d4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="de3" value="dequeues work items&lt;br&gt;(in-process call)" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#555555;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="d4" target="d5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
