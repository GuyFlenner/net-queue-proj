  </diagram>

  <diagram name="2 - Component Architecture" id="arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t2" value="Component Architecture &#8212; DI-registered components, their dependencies, and lifetimes" style="text;strokeColor=none;fillColor=#eef2f7;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a1" value="EmailProcessing.Api&lt;br&gt;Minimal API endpoint layer&lt;br&gt;(ASP.NET Core host + DI container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="a2" value="Program.cs (composition root)&lt;br&gt;AddSingleton&amp;lt;IBackgroundTaskQueue&amp;gt;(...)&lt;br&gt;AddHostedService&amp;lt;QueuedTaskProcessingService&amp;gt;()" style="shape=mxgraph.note;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="320" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="a3" value="ValidationFilter&amp;lt;SendEmailRequest&amp;gt;&lt;br&gt;(IEndpointFilter)&lt;br&gt;runs FluentValidation IValidator&amp;lt;T&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="280" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="a4" value="&amp;laquo;interface&amp;raquo;&lt;br&gt;IBackgroundTaskQueue" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="a5" value="BackgroundTaskQueue&lt;br&gt;wraps bounded Channel&amp;lt;T&amp;gt;&lt;br&gt;&lt;b&gt;DI lifetime: Singleton&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="390" width="300" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="a6" value="Bounded capacity = 100&lt;br&gt;FullMode = Wait&lt;br&gt;Producer asynchronously awaits a&lt;br&gt;free slot &#8212; never drops work,&lt;br&gt;never blocks a thread synchronously,&lt;br&gt;never grows unbounded." style="shape=mxgraph.note;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="390" width="320" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="a7" value="QueuedTaskProcessingService&lt;br&gt;: BackgroundService&lt;br&gt;&lt;b&gt;DI lifetime: Hosted Service&lt;/b&gt; (IHostedService)&lt;br&gt;single sequential consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="580" width="320" height="120" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="ae1" value="applies filter" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.15;exitY=1;entryX=0.5;entryY=0;strokeColor=#555555;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="a1" target="a3" parent="1">
