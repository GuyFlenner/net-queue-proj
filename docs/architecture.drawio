          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="ae4" value="injects (ctor)" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.2;entryX=1;entryY=0.5;strokeColor=#555555;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="a7" target="a4" parent="1">
